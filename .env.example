# Обязательное
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
DATABASE_URL=postgresql://user:pass@host:5432/family

# Схема внутри БД. Дефолт 'family'. Позволяет жить в одной базе с другим
# приложением, не сталкиваясь именами таблиц (users/tasks/settings).
DB_SCHEMA=family

# Куда слать эскалации и утренний дайджест (id группы, обычно отрицательный).
# Можно не задавать: бот запомнит чат сам по команде /start в группе.
FAMILY_CHAT_ID=-1001234567890

# Опционально
FAMILY_TZ=Europe/Kyiv
ALL_DAY_HOUR=9            # опорный час для задач без времени
DIGEST_HOUR=8             # во сколько присылать план на день
CAL_SYNC_MIN=15           # период опроса календарей, мин
CAL_HORIZON_DAYS=60       # на сколько дней вперёд разворачивать повторения
CAL_OFFSETS=24h,3h        # напоминания для событий из календарей
REMINDER_GRACE_MIN=120    # старше этого — не отправлять (защита от спама после даунтайма)
ESCALATE_AFTER_MIN=30     # через сколько после дедлайна пинговать общий чат
ESCALATION=on             # off — выключить эскалации

# Куда слать напоминания. Тело всегда уходит в личку исполнителю (если он
# писал боту /start), а в общий чат дублируется короткий пинг «глянь личку».
#   all — пинг на каждое напоминание (по умолчанию)
#   key — только на первое по задаче и в момент наступления срока
#   off — не дублировать в группу вообще
GROUP_PING=all

# На сколько дней вперёд заранее создавать задачи по повторяющимся правилам
RECUR_HORIZON_DAYS=30

# Сколько минут живёт режим ввода (добавление покупок, редактирование задачи)
STATE_TTL_MIN=10

# Умный разбор фраз. Без ключа работает регексповый фолбэк.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
